{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "app/web",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "destination": "/explorer.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/:path*",   "destination": "https://REPLACE-WITH-BACKEND-HOST/api/:path*" },
    { "source": "/graph/:path*", "destination": "https://REPLACE-WITH-BACKEND-HOST/graph/:path*" }
  ]
}
