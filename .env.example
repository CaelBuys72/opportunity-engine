# Copy this file to ".env" and paste your keys (this file is safe to commit; .env is gitignored).
# Free tiers are fine to start: Serper (~2,500 searches) + Gemini free tier.

# --- Live web search (required for "Explore Deeper") ---
SERPER_API_KEY=

# --- Evidence classification: set ONE of these (checked in this order) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
GEMINI_API_KEY=

# --- optional model overrides ---
# GEMINI_MODEL=gemini-2.0-flash
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-4o
