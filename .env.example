# Copy this file to ".env" and paste your keys (this file is safe to commit; .env is gitignored).
# Free tiers are fine to start: Serper (~2,500 searches) + Groq (generous free LLM tier).

# --- Live web search (required for "Explore Deeper") ---
SERPER_API_KEY=

# --- LLM — routed PER LAYER so heavy product generation never competes with research
#     work for the same daily free-token budget:
#       • Product generation  -> Groq (primary) then Gemini (overflow on 429)
#       • Research / Explore Deeper / Rescore / Creator+Outreach -> Cerebras, Gemini fallback
#     Each free tier is a SEPARATE daily pool, so the layers don't drain each other. ---
# Groq (product gen): https://console.groq.com  — 200k tokens/day free (gpt-oss-120b)
GROQ_API_KEY=
# Gemini (2nd product engine + fallback): https://aistudio.google.com/apikey — free, no card
GEMINI_API_KEY=
# Mistral (research-layer workhorse): https://console.mistral.ai — ~1B tokens/month free,
# no card (phone-verified). Research chain: mistral -> cloudflare -> groq.
MISTRAL_API_KEY=
# Cloudflare Workers AI text (research fallback) reuses CF_ACCOUNT_ID + CF_API_TOKEN below
# (same shared account as covers; 10k Neurons/day pool is shared between text + covers).
# CF_TEXT_MODEL=@cf/meta/llama-3.1-8b-instruct
# Cerebras is billing-gated (402) on our account — NOT in the active research chain:
# CEREBRAS_API_KEY=

# --- Ebook cover art (optional): FLUX.1-schnell (Apache-2.0, outputs sellable). ---
# Primary = Cloudflare Workers AI (shared account, 10k free Neurons/day ≈ 100+ covers,
# no card). Create an account, an API token with "Workers AI" permission, and find your
# Account ID in the dashboard. Omit both to fall back to a clean typographic cover.
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Optional alternate image provider (used only if CF_* unset):
# TOGETHER_API_KEY=

# --- Further optional LLM fallbacks (only used if the above are unset) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- optional model overrides ---
# GROQ_MODEL=openai/gpt-oss-120b   # or qwen/qwen3.8-27b — see /api/universe/groq-models
# GEMINI_MODEL=gemini-3.6-flash
# CEREBRAS_MODEL=gpt-oss-120b      # or llama-3.3-70b — Cerebras free tier caps context at ~8K
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-4o
#
# NOTE (two operators): in production each operator has their OWN keys, e.g.
#   CAEL_GROQ_API_KEY / CAEL_GEMINI_API_KEY / CAEL_CEREBRAS_API_KEY / CAEL_SERPER_API_KEY
#   SHEYLYN_GROQ_API_KEY / SHEYLYN_GEMINI_API_KEY / SHEYLYN_CEREBRAS_API_KEY / ...
# The unprefixed names above are for local/dev (open mode) only.
