# Copy this file to ".env" and paste your keys (this file is safe to commit; .env is gitignored).
# Free tiers are fine to start: Serper (~2,500 searches) + Groq (generous free LLM tier).

# --- Live web search (required for "Explore Deeper") ---
SERPER_API_KEY=

# --- LLM (research, curation, product generation). Groq free tier is the default. ---
# Get a free key at https://console.groq.com  (Sign in → API Keys → Create)
GROQ_API_KEY=

# --- Optional alternate LLM providers (used only if GROQ_API_KEY is unset) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- optional model overrides ---
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-3.6-flash
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-4o
